{
  // Numele TREBUIE sa fie identic cu al Workerului existent, altfel Cloudflare
  // creeaza unul nou in loc sa-l actualizeze pe asta.
  "name": "razvanpopescu-site",
  "compatibility_date": "2026-08-07",

  // Codul care ruleaza pe server. Fara linia asta, proiectul e "doar fisiere
  // statice" si Cloudflare refuza sa accepte variabile de mediu.
  "main": "worker.js",

  // Fisierele site-ului. Stau in radacina, exact unde sunt acum.
  // Ce nu trebuie servit public e listat in .assetsignore.
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },

  // ID-urile listelor din Brevo. NU sunt secrete, deci stau aici, in fisier.
  // Motivul e important: `wrangler deploy` sterge variabilele simple adaugate
  // din panoul Cloudflare si le inlocuieste cu ce scrie aici. Daca ar fi puse
  // doar in panou, primul push urmator le-ar sterge in tacere si formularele
  // ar trimite contacte fara lista. Secretele nu patesc asta: ele supravietuiesc.
  "vars": {
    "BREVO_LIST_TEST": "3",
    "BREVO_LIST_CONVERSATIE": "4"
  },

  "observability": {
    "enabled": true
  }
}
